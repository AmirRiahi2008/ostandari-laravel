{
  "info": {
    "name": "Ostandari Backend",
    "description": "Run composer setup, put its password in admin_password, then run Administrator login. No real credentials are included.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "admin_password",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "citizen_token",
      "value": ""
    },
    {
      "key": "challenge_id",
      "value": ""
    },
    {
      "key": "otp_code",
      "value": ""
    },
    {
      "key": "content_id",
      "value": ""
    },
    {
      "key": "ticket_reference",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Start here",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/health"
          }
        },
        {
          "name": "Administrator login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.response.code===200) pm.collectionVariables.set('admin_token',pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "My account",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/auth/me"
          }
        },
        {
          "name": "Request local OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/otp/request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"کاربر آزمایشی\",\n  \"mobile\": \"09120000000\",\n  \"national_code\": \"1234567891\",\n  \"terms_accepted\": true,\n  \"terms_version\": \"1.0\",\n  \"terms_document_sha256\": \"2404265b8f811b2fc36c447ff8b4e22954f752a7786975553b1b0a8b31070778\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.response.code===200){const d=pm.response.json().data;pm.collectionVariables.set('challenge_id',d.challenge_id);if(d.dev_code)pm.collectionVariables.set('otp_code',d.dev_code);}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/otp/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challenge_id\": \"{{challenge_id}}\",\n  \"code\": \"{{otp_code}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.response.code===200)pm.collectionVariables.set('citizen_token',pm.response.json().data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
