APP_NAME="پرتال استانداری مازندران"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ostandari
DB_USERNAME=ostandari
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
MAIL_MAILER=log

# Set the live SMS gateway before accepting real registrations.
OTP_DRIVER=log
OTP_EXPOSE_LOCAL=false
EVENT_SMS_DRIVER=log
CITIZEN_DEMO=false
PORTAL_SNAPSHOT=false
