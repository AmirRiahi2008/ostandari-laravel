APP_NAME="پرتال استانداری مازندران"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ostandari
DB_USERNAME=root
DB_PASSWORD=
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync
MAIL_MAILER=log
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
FILESYSTEM_DISK=local
OTP_DRIVER=log
OTP_EXPOSE_LOCAL=true
CITIZEN_DEMO=false
PORTAL_SNAPSHOT=false


# Optional event notification SMS gateway (same HTTPS JSON contract as OTP).
EVENT_SMS_DRIVER=log
# SMS_ENDPOINT=https://your-sms-gateway.example/send
# SMS_TOKEN=
# SMS_SENDER=
